{
  "name": "nest-portfolio-app",
  "version": "0.0.1",
  "description": "API NestJS du portfolio nedellec-julien.fr : auth JWT + 2FA, blog, projets, contact, CV, analytics",
  "author": "Julien Nédellec <contact@nedellec-julien.fr> (https://nedellec-julien.fr)",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ],
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf"
    ],
    "overrides": {
      "js-yaml": ">=4.3.1",
      "multer": ">=2.3.0",
      "qs": ">=6.16.0",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "handlebars@<4.7.10": "^4.7.10"
    }
  },
  "scripts": {
    "build": "nest build",
    "sentry:sourcemaps": "node scripts/upload-sentry-sourcemaps.mjs",
    "sentry:check-instrumentation": "node scripts/check-sentry-instrumentation.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "dev": "nest start --watch",
    "predev": "pnpm db:up && pnpm db:wait && pnpm mail:up",
    "db:up": "podman compose up -d postgres",
    "db:down": "podman compose down postgres",
    "db:reset": "podman compose down -v postgres && pnpm db:up && pnpm db:wait && pnpm db:migrate && pnpm db:seed",
    "db:wait": "until podman exec portfolio-nest-db pg_isready -U portfolio -d portfolio_nest > /dev/null 2>&1; do sleep 0.5; done",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/database/seeds/admin.seed.ts",
    "db:change-password": "tsx src/database/scripts/change-password.ts",
    "db:studio": "drizzle-kit studio",
    "mail:up": "podman compose up -d mailpit",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules --no-warnings=ExperimentalWarning -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules --no-warnings=ExperimentalWarning ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@sentry/nestjs": "^10.73.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "geoip-lite": "^2.0.3",
    "helmet": "8.3.0",
    "isbot": "^5.2.2",
    "multer": "^2.4.0",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^10.0.11",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@smithy/util-stream": "^4.8.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/ua-parser-js": "^0.7.39",
    "aws-sdk-client-mock": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "globalSetup": "<rootDir>/../test/jest-global-setup.ts",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "moduleResolution": "node",
            "module": "commonjs",
            "resolvePackageJsonExports": false
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
